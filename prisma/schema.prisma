generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model User {
  id             String          @id @default(cuid())
  name           String?
  email          String?         @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String          @default("USER")
  accounts       Account[]
  sessions       Session[]
  threads        Thread[]
  systemLogs     SystemLog[]
  aiSettings     AISettings?
  images         Image[]
  socialChannels SocialChannel[]
  posts          Post[]
  clipAssets     ClipAsset[]
}

model Image {
  id        String   @id @default(cuid())
  url       String   @db.LongText
  prompt    String?  @db.LongText
  provider  String?  // GEMINI, OPENAI
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Thread {
  id          String    @id @default(cuid())
  content     String    @db.LongText
  imageUrl    String?   @db.LongText
  status      String    @default("DRAFT")
  platforms   String?   @db.LongText
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Thread_userId_fkey")
}

model SystemLog {
  id        String   @id @default(cuid())
  level     String
  message   String   @db.Text
  details   Json?
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId], map: "SystemLog_userId_fkey")
}

model AISettings {
  id         String   @id @default(cuid())
  userId     String   @unique
  provider   String   // GEMINI, OPENAI
  apiKey     String?  @db.Text
  model      String
  imageModel String?  @default("gemini-2.5-flash-image")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// OMNICHANNEL PUBLISHER
// ==========================================

model SocialChannel {
  id           String       @id @default(cuid())
  userId       String
  provider     String       // "twitter" | "facebook" | "youtube" | "instagram" | "tiktok" | "linkedin"
  displayName  String?      // Nama akun/page/channel
  avatarUrl    String?      @db.Text
  channelId    String?      // Page ID / Channel ID / User ID di platform
  accessToken  String?      @db.Text
  refreshToken String?      @db.Text
  expiresAt    DateTime?
  metadata     Json?        // Data extra per platform (page token, scopes, dll)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  postResults  PostResult[]

  @@unique([userId, provider, channelId])
  @@index([userId])
}

model Post {
  id           String       @id @default(cuid())
  userId       String
  title        String?                    // Wajib untuk YouTube
  body         String?      @db.LongText  // Teks utama konten
  mediaUrl     String?      @db.LongText  // URL video/gambar
  mediaType    String?                    // "image" | "video" | "text"
  platformMeta Json?                      // Setting per platform {youtube: {privacy, tags}, ...}
  status       String       @default("DRAFT") // DRAFT|SCHEDULED|PUBLISHED|PARTIAL|FAILED
  scheduledAt  DateTime?
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  results      PostResult[]
  clipAssetId  String?
  clipAsset    ClipAsset?   @relation(fields: [clipAssetId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clipAssetId])
}

model PostResult {
  id          String        @id @default(cuid())
  postId      String
  channelId   String
  platform    String        // "twitter" | "facebook" | "youtube" | dll
  status      String        // "SUCCESS" | "FAILED" | "PENDING"
  externalId  String?       // ID di platform (tweet ID, video ID, post ID)
  errorMsg    String?       @db.Text
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel     SocialChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([channelId])
}

// ==========================================
// CLIPPER INTEGRATION
// ==========================================

model ClipAsset {
  id            String    @id @default(cuid())
  userId        String
  title         String    @db.VarChar(500)
  videoUrl      String    @db.Text          // Accessible URL dari /public/uploads/ atau Clipper output
  thumbnailUrl  String?   @db.Text
  durationSec   Float?
  fileSize      Int?                        // bytes
  sourceProject String?                     // Nama project di Clipper
  clipIndex     Int?                        // Index clip dalam project Clipper
  status        String    @default("READY") // READY | SCHEDULED | POSTED
  metadata      Json?                       // Extra data dari Clipper (tags, transcript, dll)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts         Post[]

  @@index([userId])
  @@index([status])
}
